# Copy to .env and adjust as needed. Every value below is a default.

# Listen address. A bare port number also works, e.g. PORT=8080.
PORT=:8080

# Leave empty to use the in-memory store. Set it to enable PostgreSQL:
# DATABASE_URL=postgres://claims:claims@localhost:5432/claims?sslmode=disable
DATABASE_URL=

# Product document loaded into the store at start-up.
SEED_FILE=seed/product.json

# Product images, served at /media/. The catalogue's signed URLs have expired.
MEDIA_DIR=assets/images
PUBLIC_BASE_URL=http://localhost:8080
REWRITE_MEDIA_URLS=true

# Detect claims from structured compliance fields (country_of_origin,
# fssai_no) in addition to marketing copy.
CLAIMS_INCLUDE_STRUCTURED=true

# Worker pool.
WORKFLOW_WORKERS=4
WORKFLOW_QUEUE_SIZE=64
WORKFLOW_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s

# debug | info | warn | error
LOG_LEVEL=info
